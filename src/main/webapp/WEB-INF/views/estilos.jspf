<%@ page pageEncoding="UTF-8" %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
	* { box-sizing: border-box; }
	body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f2f4f7; color: #1f2937; }
	.barra { background: #8b1d1d; color: #fff; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; }
	.barra a { color: #fff; }
	.contenedor { max-width: 860px; margin: 32px auto; padding: 0 16px; }
	.tarjeta { background: #fff; border-radius: 10px; padding: 28px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
	.centro { max-width: 380px; margin: 80px auto; }
	h1 { margin-top: 0; font-size: 1.6rem; }
	label { display: block; margin: 14px 0 6px; font-weight: 600; }
	input[type=text], input[type=password], input[type=number] { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 1rem; }
	.btn { display: inline-block; padding: 9px 16px; border: 0; border-radius: 6px; background: #8b1d1d; color: #fff; text-decoration: none; cursor: pointer; font-size: .95rem; }
	.btn.gris { background: #64748b; }
	.btn.azul { background: #1d4ed8; }
	.btn.pequeno { padding: 5px 10px; font-size: .85rem; }
	.completo { width: 100%; margin-top: 20px; }
	table { width: 100%; border-collapse: collapse; margin: 18px 0; }
	th, td { padding: 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
	th { background: #f8fafc; }
	.alerta { padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; }
	.alerta.error { background: #fee2e2; color: #991b1b; }
	.alerta.ok { background: #dcfce7; color: #166534; }
	.etiqueta { display: inline-block; background: #fde68a; color: #78350f; border-radius: 4px; padding: 2px 8px; margin-right: 4px; font-size: .8rem; }
	.codigo { font-size: 5rem; font-weight: 800; color: #8b1d1d; margin: 0; }
	.pista { font-size: .85rem; color: #64748b; }
</style>
